DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal

# Origins allowed to call this service directly. If everything goes through
# the gateway, this only needs the gateway's origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# Same physical Cassandra cluster as the monolith (see ../../../casssndra) --
# own keyspace, so this service's data is isolated at the keyspace level.
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=django_platform
CASSANDRA_LOCAL_DC=datacenter-1
CASSANDRA_CONSISTENCY_LEVEL=LOCAL_QUORUM

SERVE_HOST=0.0.0.0
SERVE_PORT=8001
SERVE_THREADS=8
SERVE_CONNECTION_LIMIT=300
