        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service=\"ff-net-service\"}" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
