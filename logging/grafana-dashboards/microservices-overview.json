    },

    { "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "id": 102, "collapsed": false },

    {
      "id": 7, "title": "catalog-service logs", "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service=\"catalog-service\"}" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "id": 8, "title": "ff-net-service logs", "type": "logs",
