DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal

# Origins your frontend is served from, comma-separated (scheme + host + port, no path).
# e.g. http://127.0.0.1:5173,http://192.168.1.50:5173
CORS_ALLOWED_ORIGINS=
# Only for trusted airgapped/internal networks -- allows any origin, bypassing the list above.
CORS_ALLOW_ALL_ORIGINS=False

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=django_platform
CASSANDRA_LOCAL_DC=datacenter-1
CASSANDRA_CONSISTENCY_LEVEL=LOCAL_QUORUM
# Empty = connect unauthenticated (only valid if the cluster doesn't have
# PasswordAuthenticator enabled). See casssndra/AUTH.md.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

SERVE_HOST=0.0.0.0
SERVE_PORT=8000
SERVE_THREADS=8
SERVE_CONNECTION_LIMIT=300