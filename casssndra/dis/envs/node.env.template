# Copy this to envs/<hostname>.env and fill in per node.
# Used as: docker compose --env-file envs/<hostname>.env -f ../docker-compose.node.yml up -d

NODE_NAME=cassandra-N            # unique per node: cassandra-1 .. cassandra-5
BIND_IP=                         # this host's LAN (airgapped) or private (AWS) IP
CASSANDRA_RACK=rack1             # rack1 or rack2 -- just a fault-domain label,
                                  # set to whatever grouping is real for you
                                  # (separate switch/power/room/AZ)
SEED_IPS=                        # comma-separated, same list on every node:
                                  # "<rack1-seed-ip>,<rack2-seed-ip>"
CASSANDRA_DC=datacenter-1        # leave as-is unless you change LOCAL_DC in
                                  # backend/.env to match
MAX_HEAP_SIZE=512M
HEAP_NEWSIZE=128M

# Healthcheck credentials -- defaults to the built-in superuser, which is
# fine until you rotate its password (you should, see ../../AUTH.md), at
# which point update this to match (or point it at a dedicated role).
# CASSANDRA_HEALTHCHECK_USER=cassandra
# CASSANDRA_HEALTHCHECK_PASSWORD=cassandra

# Uncomment + set when replacing a dead node -- see ../../RECOVERY.md.
# JVM_EXTRA_OPTS=-Dcassandra.replace_address_first_boot=<dead-node-ip>
