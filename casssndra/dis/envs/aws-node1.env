# AWS EC2 instance 1 (AZ-a) -> cassandra-1 (rack1 seed)
# Fill in BIND_IP with this instance's private IPv4 (Instances console -> Private IPv4 address)
# and SEED_IPS with the two seed instances' private IPs once all 5 are launched.
NODE_NAME=cassandra-1
BIND_IP=<AZ-A-INSTANCE-1-PRIVATE-IP>
CASSANDRA_RACK=rack1
SEED_IPS=<AZ-A-INSTANCE-1-PRIVATE-IP>,<AZ-B-INSTANCE-4-PRIVATE-IP>
CASSANDRA_DC=datacenter-1
MAX_HEAP_SIZE=512M
HEAP_NEWSIZE=128M
